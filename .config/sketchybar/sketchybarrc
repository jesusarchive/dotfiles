#!/bin/bash
# Dispatcher: loads the theme named in ~/.config/sketchybar/theme
# Available themes: i3 (default i3bar/i3status), omarchy (omarchy waybar),
# dwm (default dwm bar + slstatus)
# Switch with: ~/.config/sketchybar/bar-theme <name>

CONFIG_DIR="$HOME/.config/sketchybar"
THEME=$(cat "$CONFIG_DIR/theme" 2>/dev/null || echo i3)
source "$CONFIG_DIR/themes/$THEME/sketchybarrc"
